# Exercise 1: Print all even numbers from 1 to 20
print("\nExercise 1: Even numbers from 1 to 20")
for i in range(1, 21):
    if i % 2 == 0:
        print(i, end=" ")
print()

# Exercise 2: Print all odd numbers from 1 to 20
print("\nExercise 2: Odd numbers from 1 to 20")
for i in range(1, 21):
    if i % 2 != 0:
        print(i, end=" ")
print()

# Exercise 3: Print multiples of 5 from 5 to 50
print("\nExercise 3: Multiples of 5")
for i in range(5, 51, 5):
    print(i, end=" ")
print()

# Exercise 4: Sum of numbers from 1 to 10
print("\nExercise 4: Sum from 1 to 10")
total = 0
for i in range(1, 11):
    total += i
print("Sum:", total)

# Exercise 5: Sum of even numbers from 1 to 100
print("\nExercise 5: Sum of even numbers from 1 to 100")
total = 0
for i in range(2, 101, 2):
    total += i
print("Sum:", total)

# Exercise 6: Sum of odd numbers from 1 to 100
print("\nExercise 6: Sum of odd numbers from 1 to 100")
total = 0
for i in range(1, 101, 2):
    total += i
print("Sum:", total)

# Exercise 7: Multiplication table of 7
print("\nExercise 7: Table of 7")
for i in range(1, 11):
    print(f"7 x {i} = {7 * i}")

# Exercise 8: Take a number and print its table
print("\nExercise 8: Multiplication table of a number")
number = int(input("Enter a number for its table: "))
for i in range(1, 11):
    print(f"{number} x {i} = {number * i}")

# Exercise 9: Numbers from 1 to 100 divisible by both 3 and 5
print("\nExercise 9: Divisible by both 3 and 5")
for i in range(1, 101):
    if i % 3 == 0 and i % 5 == 0:
        print(i, end=" ")
print()

# Exercise 10: Count even and odd numbers from 1 to 50
print("\nExercise 10: Count even and odd numbers")
even_count = 0
odd_count = 0
for i in range(1, 51):
    if i % 2 == 0:
        even_count += 1
    else:
        odd_count += 1
print("Even count:", even_count)
print("Odd count:", odd_count)

# Exercise 11: Print list elements in reverse order
print("\nExercise 11: Reverse a list")
data = [22, 33, 12, 32, 45, 13]
for item in reversed(data):
    print(item, end=" ")
print()

# Exercise 12: Find largest number using a for loop
print("\nExercise 12: Largest number")
data = [22, 55, 12, 89, 34, 67]
largest = data[0]
for num in data:
    if num > largest:
        largest = num
print("Largest:", largest)
